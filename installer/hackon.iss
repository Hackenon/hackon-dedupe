; Inno Setup script for HackOn Photo & Video DeDupe.
;
; Build the onedir app first, then compile this to make HackOn-Setup.exe:
;     python tools/build_exe.py --installer       (does both for you)
; or by hand:
;     python tools/build_exe.py                   (produces dist\HackOn\)
;     iscc installer\hackon.iss
;
; Installs for all users into Program Files (requires admin/UAC), with a Start
; Menu shortcut and an uninstaller. User data still lives in %APPDATA%\HackOn,
; so the Program Files location stays read-only at runtime.

#define MyAppName "HackOn Photo & Video DeDupe"
; build_exe.py passes /DMyAppVersion from the VERSION file; this is the fallback
; for a plain `iscc installer\hackon.iss` compile.
#ifndef MyAppVersion
  #define MyAppVersion "1.0.0"
#endif
#define MyAppPublisher "HackOn Systems"
#define MyAppURL "https://hackonsystems.com"
#define MyAppExeName "HackOn.exe"
#define MySourceDir "..\dist\HackOn"

[Setup]
AppId={{7E031561-E1EF-432E-921C-3A5E88052C72}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppPublisher}\{#MyAppName}
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
PrivilegesRequired=admin
; 64-bit app -> install into the real Program Files (not the x86 folder) on x64/Arm64.
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir=..
OutputBaseFilename=HackOn-Setup
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
; Show the themed welcome page (modern style hides it by default).
DisableWelcomePage=no
; CRT green-phosphor wizard art (generated by tools/make_installer_art.py).
WizardImageFile=assets\wizard-large-164.png,assets\wizard-large-246.png,assets\wizard-large-328.png,assets\wizard-large-410.png
WizardSmallImageFile=assets\wizard-small-64.png,assets\wizard-small-128.png
; Dark background behind the images (BGR of #04170a) so edges blend.
WizardImageBackColor=$0A1704
WizardSmallImageBackColor=$0A1704
UninstallDisplayName={#MyAppName}
SetupIconFile=..\assets\icon.ico

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "firewall"; Description: "Allow other computers on your network to reach it (opens firewall port 5000, Private networks only)"; GroupDescription: "Network access:"; Flags: unchecked

[Files]
Source: "{#MySourceDir}\*"; DestDir: "{app}"; Flags: recursesubdirs createallsubdirs ignoreversion

[Icons]
Name: "{group}\HackOn Photo & Video DeDupe"; Filename: "{app}\{#MyAppExeName}"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\HackOn Photo & Video DeDupe"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
; Opt-in: open the LAN only when the Network-access task was ticked. The installer
; runs elevated, so netsh needs no extra prompt. Scoped to Private networks.
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall add rule name=""HackOn Photo & Video DeDupe"" dir=in action=allow protocol=TCP localport=5000 profile=private"; Tasks: firewall; Flags: runhidden; StatusMsg: "Opening firewall port 5000 for network access..."
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#MyAppName}}"; Flags: nowait postinstall skipifsilent

[Code]
// ---- CRT green-phosphor theme for the wizard body ----
// Welcome/finish panels + banner are themed via the images above; this recolors
// the inner page bodies. TColor values are in $00BBGGRR (BGR) order.
// NOTE: this is the one part that must be compiled on Windows (ISCC) to confirm;
// if a control class here isn't recognised, delete the offending branch -- the
// image theming above still applies.
const
  clCRTBg = $0A1704;   // #04170a dark panel
  clPhos  = $66FF33;   // #33ff66 phosphor green
  clSoft  = $CBECBD;   // #bdeccb soft green

procedure ThemeControls(Parent: TWinControl);
var
  i: Integer;
  C: TControl;
begin
  for i := 0 to Parent.ControlCount - 1 do
  begin
    C := Parent.Controls[i];
    if C is TNewStaticText then
      TNewStaticText(C).Font.Color := clPhos
    else if C is TNewEdit then
    begin
      TNewEdit(C).Color := clCRTBg;
      TNewEdit(C).Font.Color := clPhos;
    end
    else if C is TRichEditViewer then
    begin
      TRichEditViewer(C).Color := clCRTBg;
      TRichEditViewer(C).Font.Color := clPhos;
    end
    else if C is TNewCheckListBox then
    begin
      TNewCheckListBox(C).Color := clCRTBg;
      TNewCheckListBox(C).Font.Color := clPhos;
    end
    else if C is TNewCheckBox then
      TNewCheckBox(C).Font.Color := clPhos
    else if C is TNewNotebookPage then
      TNewNotebookPage(C).Color := clCRTBg
    else if C is TPanel then
      TPanel(C).Color := clCRTBg;

    if C is TWinControl then
      ThemeControls(TWinControl(C));
  end;
end;

procedure ApplyTheme;
begin
  WizardForm.Color := clCRTBg;
  WizardForm.MainPanel.Color := clCRTBg;
  WizardForm.Bevel.Visible := False;
  ThemeControls(WizardForm);
  WizardForm.PageNameLabel.Font.Color := clPhos;
  WizardForm.PageDescriptionLabel.Font.Color := clSoft;
end;

procedure InitializeWizard;
begin
  ApplyTheme;
end;

procedure CurPageChanged(CurPageID: Integer);
begin
  // Re-apply so controls realised per-page pick up the theme too.
  ApplyTheme;
end;

[UninstallRun]
; Remove the firewall rule on uninstall so no open port is left behind.
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall delete rule name=""HackOn Photo & Video DeDupe"""; Flags: runhidden; RunOnceId: "DelHackOnFwRule"
